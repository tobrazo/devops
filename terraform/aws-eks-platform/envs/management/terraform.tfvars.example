# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

region        = "eu-central-1"
instance_type = "t3.large"

# Windows Administrator password for RDP login.
# Min 12 chars, must contain: uppercase, lowercase, digit, special char.
windows_admin_password = "CHANGE_ME_Str0ng!Pass"

# PostgreSQL superuser password (postgres user).
postgres_password = "CHANGE_ME_another_Str0ng!Pass"

# CIDRs allowed to connect via RDP (port 3389).
# Uncomment and restrict to your IP when ready.
# rdp_allowed_cidrs = ["YOUR_IP/32"]

# CIDRs allowed to connect directly to PostgreSQL port 5432 from outside.
# Leave empty — access PostgreSQL through RDP session instead.
postgres_allowed_cidrs = []

root_volume_size_gb = 25
