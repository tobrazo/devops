# Copy to secrets.auto.tfvars and fill in REAL values.
# `*.auto.tfvars` is auto-loaded by Terraform and is gitignored — NEVER commit the real file.
# Prefer sourcing these from a secrets manager / CI variables rather than a local file.

# GHCR image-pull secret — the dockerconfigjson blob
#   kubectl create secret docker-registry ghcr --docker-server=ghcr.io \
#     --docker-username=USER --docker-password=TOKEN --dry-run=client -o json | jq -r '.data[".dockerconfigjson"]'
ghcr_creds_dockerconfigjson = "REPLACE_WITH_DOCKERCONFIGJSON"

# Application secret JSON payloads (consumed as envFrom sources).
b2b_web_secrets_json         = "REPLACE_WITH_JSON"
nestjs_app_secrets_back_json = "REPLACE_WITH_JSON"

# Cloudflare API tokens (JSON, e.g. {"api-token":"..."}) for external-dns + cert-manager DNS-01.
cloudflare_external_dns_json       = "REPLACE_WITH_JSON"
cloudflare_cert_manager_json       = "REPLACE_WITH_JSON"
cloudflare_cert_manager_front_json = "REPLACE_WITH_JSON"

# Argo CD Slack notifications webhook.
argocd_slack_webhook_url = "https://hooks.slack.com/services/REPLACE_WITH_SLACK_WEBHOOK"

# Argo CD repo SSH private key (for private git repos). Leave "" if unused.
argocd_repo_ssh_private_key = "REPLACE_WITH_SSH_PRIVATE_KEY"
