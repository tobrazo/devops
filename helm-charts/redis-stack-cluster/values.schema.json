{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "redis-stack-cluster values",
  "type": "object",
  "required": ["replicaCount", "image", "storage"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 6, "multipleOf": 2 },
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "storage": {
      "type": "object",
      "required": ["size"],
      "properties": {
        "size": { "type": "string" },
        "className": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": { "type": "integer" },
        "gossipPort": { "type": "integer" },
        "headless": { "type": "string" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "redisExporter": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer" }
      }
    },
    "fixIP": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
