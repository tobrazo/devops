# Copy to .env and fill in real values.
# .env is gitignored — never commit it.

# ─── Pandora (required) ────────────────────────────────────────
PANDORA_LOGIN=you@example.com
PANDORA_PASSWORD=REPLACE_WITH_PANDORA_PASSWORD

# ─── Pandora (optional) ────────────────────────────────────────
# Use p-on.ru for the consumer cabinet, pro.p-on.ru for the dealer cabinet
PANDORA_HOST=pro.p-on.ru

# Login endpoint tuning — only touch these if Pandora changes their web UI
# (see "Verify the login endpoint" in the project README)
PANDORA_LOGIN_PATH=/api/users/login
PANDORA_LOGIN_FIELD=login
PANDORA_LOGIN_FORMAT=json

# Comma-separated device IDs to export (empty = every device you can see)
PANDORA_DEVICE_IDS=REPLACE_WITH_DEVICE_ID

# How often to poll the Pandora API (seconds). Don't go below 5.
POLL_INTERVAL_SEC=10

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ─── Grafana (required — compose refuses to start without it) ──
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ─── Telegram alerts (optional) ────────────────────────────────
# Create a bot via @BotFather, get the token.
# To get the chat ID: send any message to your bot, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates  and find "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
