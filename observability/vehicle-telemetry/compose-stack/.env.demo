# Demo mode — the stack runs against the bundled mock cabinet.
# No Pandora account, no vehicle, no real credentials involved.
#
#   docker compose --env-file .env.demo --profile demo up -d --build
#
# This file is committed on purpose: nothing in it is a secret.

PANDORA_LOGIN=demo@example.com
PANDORA_PASSWORD=demo
PANDORA_HOST=mock-pandora:8080
PANDORA_SCHEME=http
PANDORA_DEVICE_IDS=1234567890
POLL_INTERVAL_SEC=10
LOG_LEVEL=INFO

GRAFANA_USER=admin
GRAFANA_PASSWORD=demo
# Demo only — lets anyone open the dashboard without logging in.
GRAFANA_ANONYMOUS=true

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
